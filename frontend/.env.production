# Production build env for Cloudflare Pages hosting.
# Content is served as static JSON snapshots under /api (Pages serves them);
# adaptivity routes to the Cloudflare Worker. Set in a file (not the shell) to
# avoid Git Bash / MSYS path conversion mangling the leading-slash value.
VITE_API_BASE=/api
# Dynamic AI layer (BigAL rail, chat, grading, generation) -> alget-llm Worker.
# Content/search stay on the static /api above.
VITE_LLM_API_BASE=https://alget-llm.jewoong-moon.workers.dev
VITE_ADAPTIVE_WORKER_URL=https://alget-adaptive-recommendation.jewoong-moon.workers.dev
