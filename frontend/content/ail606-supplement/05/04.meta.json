{
  "chapter_title": "Usability Testing and Learning Evidence",
  "title": "Learning Metrics and Usability Metrics",
  "description": "AIL 606 textbook section connecting learning metrics and usability metrics to moderated usability test script with observation-to-revision trace, reader notes, support moments, and revision evidence.",
  "learning_objectives": [
    {
      "id": "ail606-supplement-05-04-lo-01",
      "statement": "Classify a metric as usability (operability) or learning (capability gain) by the construct it measures"
    },
    {
      "id": "ail606-supplement-05-04-lo-02",
      "statement": "Pair each claim with a metric that has the validity to support it, never a proxy"
    },
    {
      "id": "ail606-supplement-05-04-lo-03",
      "statement": "Read satisfaction as an attitude signal, not as evidence of learning or of effectiveness"
    },
    {
      "id": "ail606-supplement-05-04-lo-04",
      "statement": "Combine completion, time, error, and outcome data into a picture no single number could give"
    }
  ],
