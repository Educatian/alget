igger": "transcript shows a prompt and an output accepted as-is with no teacher edit", "feedback": "Troubleshoot the output. Check reading level, biased examples, and accuracy before any item reaches a student.", "rail_action": "practice"}, {"id": "cat531_supplement_8_2_teachgen_no_rejected_suggestion", "pattern": "transcript_with_no_rejected_suggestion", "description": "Submitting a clean final prompt with no record of any suggestion the teacher modified or rejected, hiding where teacher judgment intervened", "trigger": "transcript shows only the polished final prompt and no edit history", "feedback": "Keep at least one rejected or modified suggestion in the transcript so your judgment is inspectable.", "rail_action": "represent"}, {"id": "cat531_supplement_8_2_teachgen_delegating_judgment", "pattern": "delegating_protected_judgment_to_the_tool", "description": "Letting TeachGen@i auto-grade open-response work or auto-contact families, handing over judgment and consent decisions that belong to the teacher and district policy", "trigger": "teacher accepts a tool offer to grade short answers or email parents automatically", "feedback": "Short-answer judgment and family contact are teacher and policy decisions. Reject tool defaults that cross that boundary.", "rail_action": "ask"}, {"id": "cat531_supplement_8_2_teachgen_blind_to_bias", "pattern": "missing_biased_or_off_context_examples", "description": "Not noticing that generated items assume student background (family trips, household income) and so disadvantage some students", "trigger": "transcript leaves a context-loaded example unedited", "feedback": "Scan generated examples for assumptions about income or experience and swap them for context-neutral ones.", "rail_action": "explain"}]}