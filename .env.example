# Browser-safe Cloudflare Pages build variables
VITE_SUPABASE_URL=replace-with-supabase-project-url
VITE_SUPABASE_ANON_KEY=replace-with-supabase-publishable-key
VITE_LLM_API_BASE=optional-worker-base-url
VITE_FINGRIP_UNITY_URL=https://fingrip-lab-unity.pages.dev/
VITE_GECKOGRIP_UNITY_URL=https://geckogrip-lab-unity.pages.dev/
VITE_PINEMORPH_UNITY_URL=https://pinemorph-lab-unity.pages.dev/
VITE_TRABECULA_UNITY_URL=https://trabecula-lab-unity.pages.dev/

# Fail-closed engineering-study survey portal. Keep disabled until the exact
# imported Qualtrics projects pass IRB, expert/cognitive/pilot, scoring,
# privacy, mobile, synthetic-response, and export QA.
VITE_ENGINEERING_STUDY_SURVEYS_ENABLED=false
VITE_ENGINEERING_STUDY_QUALTRICS_DC=az1
VITE_ENGINEERING_STUDY_PRE_SID=
VITE_ENGINEERING_STUDY_POST_SURVEY_SID=
VITE_ENGINEERING_STUDY_POSTTEST_SID=
VITE_ENGINEERING_STUDY_GIFT_CARD_SID=
VITE_ENGINEERING_STUDY_RETENTION_SID=

# Cloudflare Worker secrets and server-side configuration
OPENROUTER_API_KEY=replace-with-openrouter-api-key
ALGET_ADMIN_TOKEN=optional-admin-token
OPENROUTER_MODEL=optional-openrouter-model
SUPABASE_URL=replace-with-supabase-project-url
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Local-only learner pathway demo. Keep false/unset for hosted environments;
# the frontend only displays the sample code when its matching Vite flag is
# also true.
ALGET_DEMO_MODE=false
VITE_ALGET_DEMO_MODE=false

# Keep disabled for ordinary deployments. Set to strict only after IRB approval,
# schedule import, migration/RLS QA, and treatment/comparison runtime verification.
ENGINEERING_STUDY_ENFORCEMENT=optional-off-or-strict

# Server-only variables for scripts/qa_engineering_study_staging.py.
# Use a disposable staging project only. Never expose or commit the service key.
ALGET_STAGING_SUPABASE_URL=https://replace-with-nonproduction-ref.supabase.co
ALGET_STAGING_SUPABASE_ANON_KEY=replace-with-staging-publishable-key
ALGET_STAGING_SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
