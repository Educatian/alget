# Required backend provider credential
GEMINI_API_KEY=replace-with-provider-api-key

# Required cohort access codes
ENGINEERING_ACCESS_CODE=replace-with-engineering-access-code
EDUCATION_ACCESS_CODE=replace-with-education-access-code
RESEARCHER_ACCESS_CODE=replace-with-researcher-access-code
# Local development only; keep false/unset in hosted environments.
ALGET_DEMO_MODE=false

# Optional backend settings
GOOGLE_API_KEY=optional-alternate-provider-api-key
ALGET_ALLOWED_ORIGINS=optional-comma-separated-origins

# Admin control plane and instructor invitations
SUPABASE_URL=replace-with-supabase-project-url
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
ALGET_ADMIN_TOKEN=optional-server-to-server-admin-token
