{
  // TAMU preview tutor. Separate from the production backend (alget-backend) and from the
  // existing alget-tamu-api worker. Models run on UA's Microsoft Foundry (UA OIT's approved
  // route); MODEL is the Foundry deployment name. The key is a secret set by the owner:
  //   npx wrangler secret put FOUNDRY_API_KEY --name alget-tamu-tutor
  "$schema": "../backend-worker/node_modules/wrangler/config-schema.json",
  "name": "alget-tamu-tutor",
  "main": "src/index.js",
  "compatibility_date": "2026-09-24",
  "vars": {
    "TUTOR_ENABLED": "true",
    "FOUNDRY_ENDPOINT": "https://ua-education-sail-and-me-foundry.openai.azure.com/openai/v1",
    "MODEL": "gpt-4.1-mini",
    "REASONING_EFFORT": "",
    "CONTENT_BASE": "https://tamu-3d-labs.alget-tamu-ai-literacy.pages.dev/demo-api",
    "ALLOWED_ORIGINS": "https://tamu-3d-labs.alget-tamu-ai-literacy.pages.dev",
    "DAILY_CAP": "500",
    "TIMEOUT_MS": "8000"
  },
  "kv_namespaces": [
    { "binding": "USAGE", "id": "13a6f326f29d4646ab8187e1324bc6c4" }
  ],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "4207", "simple": { "limit": 12, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
